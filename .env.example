# ==============================================================================
# LOST & FOUND HUB — ENVIRONMENT CONFIGURATION TEMPLATE
# Status: ₹0 MVP Foundation
# ==============================================================================

# Backend Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://localhost:5432/lostandfound
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lostandfound
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Spring Security & JWT Configuration
# In production, provide a strong 256-bit base64-encoded secret
JWT_SECRET=dGhpcy1pcy1hLXNlY3VyZS1kZXYtamd0LXNlY3JldC1rZXktZm9yLWxvc3QtYW5kLWZvdW5kLWh1Yi0yMDI2
JWT_EXPIRATION_MS=86400000

# CORS Configuration (comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Server Port
SERVER_PORT=8080

# Lifecycle Configuration (days before auto-archiving unresolved items)
ARCHIVE_AFTER_DAYS=30

# File Storage Configuration (local for dev / free-tier object storage for prod)
STORAGE_TYPE=local
STORAGE_UPLOAD_DIR=./uploads

# Frontend Configuration (used by Vite)
VITE_API_BASE_URL=/api
